   4          unsigned int high_time = 1500;  // 高电平时间，单位us
   5          
   6          // 精确的定时器初始化（11.0592MHz晶振）
   7          void Timer_Init()
   8          {
   9   1          TMOD = 0x01;    // 定时器0工作方式1
  10   1          
  11   1          // 11.0592MHz晶振的精确计算：
  12   1          // 机器周期 = 12 / 11.0592MHz ≈ 1.08507us
  13   1          // 100us需要的机器周期数 = 100 / 1.08507 ≈ 92.16 → 取整92
  14   1          // 定时器初值 = 65536 - 92 = 65444 = 0xFFA4
  15   1          TH0 = 0xFF;     
  16   1          TL0 = 0xA4;
  17   1          
  18   1          ET0 = 1;        // 开启定时器0中断
  19   1          EA = 1;         // 开启总中断
  20   1          TR0 = 1;        // 启动定时器0
  21   1      }
  22          
  23          // 设置舵机角度函数
  24          void Set_Servo_Angle(unsigned char angle)
  25          {
  26   1          // 角度转换为脉冲宽度：0度=500us, 180度=2500us
  27   1          high_time = 500 + (angle * 2000) / 180;
  28   1          
  29   1          // 限制范围
  30   1          if(high_time < 500) high_time = 500;
  31   1          if(high_time > 2500) high_time = 2500;
  32   1      }
  33          
  34          // 毫秒延时函数
  35          void Delay_ms(unsigned int ms)
  36          {
  37   1          unsigned int i, j;
  38   1          for(i = 0; i < ms; i++)
  39   1              for(j = 0; j < 114; j++);  // 针对11.0592MHz调整
  40   1      }
  41          
  42          // 简化的主函数 - 只测试基本功能
  43          void main()
  44          {
  45   1          Timer_Init();
  46   1          
  47   1          // 简单测试：只在0度和180度之间切换
  48   1          while(1)
  49   1          {
  50   2              Set_Servo_Angle(0);    // 0度
  51   2              Delay_ms(20);
  52   2              
  53   2              Set_Servo_Angle(180);  // 180度
  54   2              Delay_ms(20);
