  57          volatile unsigned int pulse_ticks = 15;  // 高电平持续的周期数（初始1500us/100=15）
  58          void Timer0_ISR() interrupt 1
  59          {
  60   1          static unsigned int counter = 0;
  61   1          
  62   1          // 重装初值
  63   1          TH0 = 0xFF;
  64   1          TL0 = 0xA4;
  65   1          
  66   1          counter++;
  67   1          
  68   1          if(counter == 1)
  69   1          {
  70   2              servo = 1;  // 每个周期开始，输出高电平
  71   2          }
  72   1          
  73   1          if(counter == pulse_ticks)
  74   1          {
  75   2              servo = 0;  // 高电平时间到，输出低电平
  76   2          }
  77   1          
  78   1          if(counter >= 200)  // 20ms周期结束
  79   1          {
  80   2              counter = 0;
  81   2          }
  82   1      }


