  22          // 获取距离函数
  23          unsigned int GetDistance(void)
  24          {
  25   1          unsigned long time_cnt = 0;
  26   1          unsigned int temp_distance = 0;
  27   1          unsigned int timeout = 0;
  28   1          
  29   1          // 发送触发脉冲（10us高电平）
  30   1          Trig = 1;
  31   1          Delay20us();  // 延时20us
  32   1          Delay20us();  // 再延时20us，总共40us确保可靠
  33   1          Trig = 0;
  34   1          
  35   1          // 等待回声开始（带超时保护）
  36   1          while(!Echo)
  37   1          {
  38   2              Delay20us();
  39   2              timeout++;
  40   2              if(timeout > 500)  // 约10ms超时
  41   2              {
  42   3                  return 0;  // 返回0表示超时
  43   3              }
  44   2          }
  45   1          
  46   1          // 开始计时（简单循环计数方式，不依赖定时器）
  47   1          time_cnt = 0;
  48   1          while(Echo)
  49   1          {
  50   2              Delay20us();  // 每次延时约20us
  51   2              time_cnt++;
  52   2              
  53   2              // 超时保护（最大测量距离约4.5米，对应约26ms）
  54   2              if(time_cnt > 1300)  // 1300 * 20us = 26ms
