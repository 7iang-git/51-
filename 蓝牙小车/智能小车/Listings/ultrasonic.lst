  62   1          // 距离(cm) = 时间(us) / 58
  63   1          temp_distance = (unsigned int)((time_cnt * 20) / 58);
  64   1          
  65   1          // 限制最大距离
  66   1          if(temp_distance > 450)
  67   1          {
  68   2              temp_distance = 450;
  69   2          }
  70   1          
  71   1          return temp_distance;
  72   1      }
