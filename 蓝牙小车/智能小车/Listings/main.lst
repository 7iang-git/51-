  48   2         {
  49   3          Car_SharpStop();break;
  50   3         }
  51   2        }
  52   1      }
  53          ////////////////////////串口中断初始化函数///////////////////////
  54          void Uart_Init()
C51 COMPILER V9.59.0.0   MAIN                                                              12/10/2025 15:32:10 PAGE 2   

  55          {
  56   1          PCON = 0x00;   // 关倍频
  57   1          SCON = 0x50;   // 串口模式1，允许接收
  58   1          
  59   1          // 只设置定时器1，不影响定时器0
  60   1          TMOD &= 0x0F;   // 清除高4位（定时器1），保留低4位（定时器0）
  61   1          TMOD |= 0x20;   // 设置定时器1为模式2（8位自动重装）
  62   1          
