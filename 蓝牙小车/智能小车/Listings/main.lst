  83   1      
  84   1      }
  85          /////////////////////////////定时器0pwm//////////////////////////////
  86          void Timer0_Routine() interrupt 1   
  87          {
  88   1       TL0 = (65535-184)%256;       //设置定时初始值
  89   1        TH0 = (65535-184)/256;        //设置定时初始值
  90   1        t++;
  91   1        if(t<=PWML)
  92   1        {
  93   2          ENAL=1;
  94   2        }
  95   1        else{ENAL=0;} 
  96   1        
  97   1        if(t<=PWMR)
  98   1        {
  99   2          ENAR=1;
 100   2        }
 101   1        else{ENAR=0;} 
 102   1        
 103   1        if(t>100) 
 104   1        {
 105   2          t=0;
 106   2        }
 107   1        //周期为200微秒乘以100  PWM为百分比 范围0到100
 108   1      }
