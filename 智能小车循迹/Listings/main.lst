 138          //////////////////////main函数//////////////////////////////
 139          void main()
 140          {   unsigned int dis = 0;
 141   1          static unsigned int measure_counter = 0;
 142   1          
 143   1          Timer0_Init();
 144   1          Timer2_Init();
 145   1          Uart_Init();
 146   1          
 147   1          // 等待系统稳定
 148   1          Delay(1000);
 149   1          
 150   1          while(1)
 151   1          {
 152   2             // 更新超声波状态机（非阻塞）
 153   2              Sonar_Update();
 154   2              
 155   2              // 每50次循环触发一次测量（控制测量频率）
 156   2              measure_counter++;
 157   2              if(measure_counter >= 50)
 158   2              {
 159   3                  measure_counter = 0;
 160   3                  Sonar_Trigger();  // 触发测量
 161   3              }
 162   2              
 163   2              // 获取当前距离
 164   2              dis = GetDistance();
 165   2              
 166   2              // 避障处理
 167   2              if(dis < 30 && dis > 0)
 168   2              {
 169   3                  Obstacle_Avoidance(dis);
 170   3              }
 171   2              else
 172   2              {
 173   3                  // 没有障碍物时执行巡线
 174   3                  Turn();
 175   3              }
 176   2              
 177   2              // 短延时，避免循环过快
 178   2              {
