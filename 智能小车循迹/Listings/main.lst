  67          ////////////////////////串口中断初始化函数///////////////////////
  68          void Uart_Init()
  69          {
  70   1        PCON=0x00;   //关倍频
  71   1        SCON=0x50;   
  72   1        //用定时器1做波特率发生器 下面是其寄存器的配置
