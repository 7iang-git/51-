 197          /////////////////////////////定时器0pwm//////////////////////////////
 198          void Timer0_Routine() interrupt 1   
 199          {
 200   1       TL0 = (65535-184)%256;       //设置定时初始值
 201   1        TH0 = (65535-184)/256;        //设置定时初始值
 202   1        t++;
