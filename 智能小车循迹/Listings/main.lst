  81   1      }
  82          //////////////////////避障处理函数//////////////////////////////
  83          void Obstacle_Avoidance(unsigned int dist)
  84          {
  85   1          if(dist < 30 && dist > 0)  // 检测到障碍物（30cm内）
  86   1          {
  87   2              switch(avoid_state)
  88   2              {
  89   3                  case 0:  // 立即停止
  90   3                      Car_SharpStop();
  91   3                      avoid_timer++;
  92   3                      if(avoid_timer > 50)  // 停止500ms
  93   3                      {
  94   4                          avoid_state = 1;
  95   4                          avoid_timer = 0;
  96   4                      }
  97   3                      break;
  98   3                      
  99   3                  case 1:  // 后退
 100   3                      Car_Back();
 101   3                      avoid_timer++;
 102   3                      if(avoid_timer > 30)  // 后退300ms
 103   3                      {
 104   4                          avoid_state = 2;
 105   4                          avoid_timer = 0;
 106   4                      }
 107   3                      break;
 108   3                      
 109   3                  case 2:  // 右转
 110   3                      Car_SharpRight();
 111   3                      avoid_timer++;
 112   3                      if(avoid_timer > 80)  // 右转800ms
 113   3                      {
 114   4                          avoid_state = 3;
 115   4                          avoid_timer = 0;
 116   4                      }
C51 COMPILER V9.59.0.0   MAIN                                                              12/09/2025 21:13:49 PAGE 3   

 117   3                      break;
 118   3                      
 119   3                  case 3:  // 短暂停止
 120   3                      Car_Stop();
 121   3                      avoid_timer++;
 122   3                      if(avoid_timer > 20)  // 停止200ms
 123   3                      {
 124   4                          avoid_state = 0;  // 完成避障，返回初始状态
 125   4                          avoid_timer = 0;
 126   4                      }
 127   3                      break;
 128   3              }
 129   2          }
 130   1          else
 131   1          {
 132   2              // 没有障碍物，重置避障状态
 133   2              avoid_state = 0;
 134   2              avoid_timer = 0;
 135   2          }
 136   1      }
