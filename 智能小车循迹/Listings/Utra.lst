 160          /////////////////////////////////触发一次测量//////////////////////////////
 161          void Sonar_Trigger(void)
 162          {
 163   1          if(sonar_state == SONAR_IDLE)
 164   1          {
 165   2              need_trigger = 1;
 166   2          }
 167   1          // 如果正在测量中，忽略本次触发
 168   1      }
 169          
 170          /////////////////////////////////获取当前距离//////////////////////////////
 171          unsigned int GetDistance(void)
 172          {
 173   1          return distance;
 174   1      }
